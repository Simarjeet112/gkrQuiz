# Server Port
PORT=5001

# Database Configuration
# Default: SQLite file (zero external dependencies required)
# For PostgreSQL in production, provide:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/geekroom_arena
DATABASE_URL=
SQLITE_PATH=./data/geekroom_arena.db
PG_SSL=false

# Authentication Secret
JWT_SECRET=geekroom-production-super-secret-key-change-me

# Initial Organizer Credentials (seeded automatically on startup)
ADMIN_EMAIL=admin@geekroom.in
ADMIN_PASSWORD=GeekroomAdmin2025!
